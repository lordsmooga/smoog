// Cloudflare reads this on every deploy.
// "name" has to match your Worker's name in the Cloudflare dashboard.
{
    "name": "smoog",
    "main": "worker.js",
    "compatibility_date": "2026-09-01",
    "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/media/*"]
    },
    "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "smoognet" }
    ]
}
